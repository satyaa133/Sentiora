POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@localhost:5432/Sentiora

REDIS_URL=redis://localhost:6379/0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_API_BASE_URL=http://localhost:8000
EXTENSION_API_BASE_URL=http://localhost:8000

CORS_ORIGINS=["http://localhost:5173"]

# ── AI / LLM Configuration ──────────────────────────────────────────────────
# Required for Ask Sentiora AI answers AND semantic search embeddings.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for generating semantic search embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model used for RAG chat completions (Ask Sentiora answers).
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── RAG Retrieval Tuning ─────────────────────────────────────────────────────
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.65
RAG_MAX_CONTEXT_CHARS=6000