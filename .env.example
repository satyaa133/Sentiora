POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV
# Host publish port for Docker Postgres. If Windows already uses 5432, set POSTGRES_PORT=5433
# and point local DATABASE_URL at 127.0.0.1:5433.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/Sentiora

REDIS_URL=redis://127.0.0.1:6379/0
# Host publish port for Docker Redis. Container Redis stays on 6379; backend/worker
# in Compose use redis://redis:6379/0. If the host already uses 6379, set REDIS_PORT=6380
# and point local (non-Docker) REDIS_URL at redis://127.0.0.1:6380/0.
REDIS_PORT=6379

# Host port for the opt-in containerised backend (docker compose --profile app).
# Host-run `npm start` always binds 127.0.0.1:8000; LAN access is opt-in (README).
BACKEND_PORT=8000
# Docker port bindings. Keep 127.0.0.1 unless you deliberately need LAN access.
# BIND_ADDRESS=127.0.0.1

# Local pgAdmin (http://127.0.0.1:5050). Defaults: admin@sentiora.ai / admin.
# Changing these after first start needs the pgadmin_data volume to be recreated.
# PGADMIN_DEFAULT_EMAIL=admin@sentiora.ai
# PGADMIN_DEFAULT_PASSWORD=admin

# ── Frontend + extension build config ───────────────────────────────────────
# Vite reads VITE_* ONLY from this repo-root .env (frontend/ and extension/ set
# envDir to the repo root). Restart `npm start` / rebuild the extension after edits.
# API origin without /api/v1. Must be reachable from the *browser* (for LAN use,
# the backend PC's IP, e.g. http://192.168.1.20:8000 — "localhost" means the
# viewer's own machine).
VITE_API_BASE_URL=http://localhost:8000
# Web app origin. The extension opens it and only accepts sign-in/out sync from
# this exact origin.
VITE_APP_URL=http://localhost:5173

# Must list every origin the web app is opened from (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# ── AI / LLM Configuration ──────────────────────────────────────────────────
# Used for Ask Sentiora answers and optional semantic embeddings.
# Copy these values into backend/.env as well (Docker backend/worker read that file).
#
# If no provider key is set:
#   POST /api/v1/chat still returns HTTP 200 with a short grounded answer from
#   retrieved READY memory (used_fallback=true). Semantic search falls back to
#   lexical matching. Set a key for LLM-generated answers.
#
# Chat provider: "openai", "gemini", or "openrouter" (chat only, no embeddings)
LLM_PROVIDER=openai
# Embeddings for semantic search: "auto" | "openai" | "gemini" | "none".
# auto = follow LLM_PROVIDER when it supports embeddings; with openrouter, use
# OPENAI_API_KEY, else GEMINI_API_KEY. Without an embedding key search is lexical-only.
# Changing the embedding model requires re-capturing (vectors are model-specific).
EMBEDDING_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini Configuration
GEMINI_API_KEY=
# Must output 1536 dimensions (text-embedding-004 cannot).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=anthropic/claude-3-haiku

# ── RAG Retrieval Tuning ─────────────────────────────────────────────────────
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.65
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_OUTPUT_TOKENS=900

# ── Auth / security ──────────────────────────────────────────────────────────
# Required when APP_ENVIRONMENT is not development.
JWT_SECRET_KEY=DEV_SECRET_KEY_CHANGE_IN_PRODUCTION_SENTIORA_2026
# Non-development environments require a 32+ char JWT_SECRET_KEY and explicit CORS_ORIGINS.
# Reverse proxies whose X-Forwarded-For is trusted for client IPs (JSON list); empty = ignore the header.
TRUSTED_PROXY_IPS=[]
MAX_REQUEST_BODY_BYTES=4194304

# ── Tests ────────────────────────────────────────────────────────────────────
# pytest and Playwright never use DATABASE_URL directly. They use TEST_DATABASE_URL,
# or derive a "sentiora_test" database on the same server when it is unset, and
# refuse any database whose name lacks "test" or equals the dev database.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/sentiora_test

# Per-IP and per-user request limits (requests per 60s window)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_BASE_BACKOFF_SECONDS=2
FAILED_LOGIN_MAX_BACKOFF_SECONDS=60
