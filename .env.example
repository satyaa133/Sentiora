# Copy to .env for local development. Never put real credentials in this file.
# User-specific credentials and overrides belong in the ignored .env.local.

# Local Compose defaults
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/Sentiora
REDIS_URL=redis://127.0.0.1:6379/0
# Connections per API/worker process and extra ones under load (D17). Production
# compose uses 20 + 20 (S9); the code default 5 + 10 is enough for development.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Backend
APP_NAME=Sentiora Backend
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
# Use a unique random value outside local development.
JWT_SECRET_KEY=replace_with_a_unique_local_secret

# AI provider (optional for local development). LLM_PROVIDER=fake is a stand-in
# for load tests only (D17) and is refused when APP_ENVIRONMENT=production.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Local CPU models need no API key
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
# Retrieval bars tuned for the local model (S3, D14, D16). The code default
# RAG_MIN_SIMILARITY=0.25 is for remote embeddings and lets everything through locally.
RAG_MIN_SIMILARITY=0.65
RAG_QUESTION_MIN_SIMILARITY=0.60
RAG_RERANK_MIN_SCORE=-0.6

# Vite exposes VITE_* values to the browser. Never put secrets in VITE_*.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Sentiora
VITE_EXTENSION_NAME=Sentiora Extension
