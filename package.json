{
  "name": "sentiora",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "frontend",
    "extension",
    "shared"
  ],
  "scripts": {
    "start": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:extension": "npm run dev --workspace extension",
    "dev:shared": "npm run dev --workspace shared",
    "dev:backend": "node scripts/run-python.mjs -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:worker": "node scripts/run-python.mjs -m app.workers.worker",
    "build": "npm run build:frontend && npm run build:extension && npm run build:shared",
    "build:frontend": "npm run build --workspace frontend",
    "build:extension": "npm run build --workspace extension",
    "build:shared": "npm run build --workspace shared",
    "package:extension": "node scripts/package-extension.mjs",
    "icons:extension": "node scripts/generate-extension-icons.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "perf:landing": "node scripts/measure-landing.mjs",
    "lint": "npm run lint:frontend && npm run lint:extension && npm run lint:shared && npm run lint:backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "lint:extension": "npm run lint --workspace extension",
    "lint:shared": "npm run lint --workspace shared",
    "lint:backend": "node scripts/run-python.mjs -m ruff check app tests",
    "format": "npm run format:frontend && npm run format:extension && npm run format:shared && npm run format:backend",
    "format:frontend": "npm run format --workspace frontend",
    "format:extension": "npm run format --workspace extension",
    "format:shared": "npm run format --workspace shared",
    "format:backend": "node scripts/run-python.mjs -m ruff format app tests",
    "test": "npm run test:frontend && npm run test:extension && npm run test:shared && npm run test:backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:extension": "npm run test --workspace extension",
    "test:shared": "npm run test --workspace shared",
    "test:backend": "node scripts/run-python.mjs -m pytest",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:extension && npm run typecheck:shared && npm run typecheck:backend",
    "typecheck:frontend": "npm run typecheck --workspace frontend",
    "typecheck:extension": "npm run typecheck --workspace extension",
    "typecheck:shared": "npm run typecheck --workspace shared",
    "typecheck:backend": "node scripts/run-python.mjs -m mypy app",
    "test:e2e": "playwright test",
    "test:db:prepare": "node scripts/run-python.mjs -m tests.testdb prepare",
    "verify:youtube-extension": "node scripts/verify-youtube-extension.mjs",
    "compose:up": "docker compose up -d postgres redis",
    "compose:down": "docker compose down",
    "check:secrets": "node scripts/check-client-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/chrome": "^0.0.275",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
