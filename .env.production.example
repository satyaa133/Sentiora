# Production settings for docker-compose.prod.yml.
# Copy to .env.production (gitignored), fill in real values, and keep it out of
# version control. Prefer your platform's secret manager where available.

# Required
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
# Public origin(s) of the web app, JSON list
CORS_ORIGINS=["https://app.example.com"]

# Optional
POSTGRES_USER=sentiora
POSTGRES_DB=sentiora
WEB_PORT=8080
WEB_BIND=0.0.0.0
API_WORKERS=2

# AI providers. Chat: LLM_PROVIDER=openai|gemini|openrouter.
# Semantic search needs an embedding key: OPENAI_API_KEY or GEMINI_API_KEY
# (EMBEDDING_PROVIDER=auto|openai|gemini|none). Without one, search is lexical-only.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-4.5

# pgAdmin (only with `--profile admin`; bound to 127.0.0.1)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
