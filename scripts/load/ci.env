# Settings for the GitHub Actions load test (.github/workflows/load-test.yml).
# Change a value and push the branch to run again; each run's numbers go in
# docs/TASKS.md (S9 row). Secrets are generated per run, never stored here.
LOAD_USERS=500
RAMP=2m
HOLD=10m

# What S9 tunes (REBUILD_PLAN S9, D17).
# Run 1 (5 + 10): pool exhausted. Each API process runs up to 40 requests in
# threads, and a finished request needs a free thread to return its
# connection, so the pool must cover the 40 threads: 20 + 20.
# Run 2: no errors, but CPU-bound (4 cores); run 3 seeds saves as enriched.
# Run 4: the web app polls the feed only while a save is processing.
API_WORKERS=2
WORKER_COUNT=2
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
LLM_MAX_CONCURRENT=10
