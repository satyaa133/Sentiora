# Copy to scripts/load/.env.load (git-ignored) and fill in throwaway values.
# These secrets only protect the local load-test stack; never reuse real ones.
POSTGRES_PASSWORD=change-me-load-postgres
REDIS_PASSWORD=change-me-load-redis
# 32+ characters.
JWT_SECRET_KEY=change-me-load-jwt-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:8090"]
# Shared password of the seeded load-0001..N@example.com users (12+ characters).
LOAD_USER_PASSWORD=change-me-load-users

LOAD_USERS=500
WEB_PORT=8090

# What S9 tunes (REBUILD_PLAN S9, D17).
API_WORKERS=2
WORKER_COUNT=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LLM_MAX_CONCURRENT=10
