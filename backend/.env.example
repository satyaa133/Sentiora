APP_NAME=Sentiora Backend
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@localhost:5432/Sentiora
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]

# ── AI / LLM Configuration ──────────────────────────────────────────────────
# Required for Ask Sentiora AI answers AND semantic search embeddings.
# Without this key, the system falls back to keyword-only search and
# Ask Sentiora returns a 503 error instead of an AI answer.
#
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for generating semantic search embeddings.
# Change only if you need a different dimension (update embedding_dimensions too).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model used for RAG chat completions (Ask Sentiora answers).
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── RAG Retrieval Tuning ─────────────────────────────────────────────────────
# Number of memory chunks retrieved per question (higher = more context, slower).
RAG_TOP_K=8

# Maximum cosine distance for a chunk to be considered relevant.
# Range: 0.0 (exact match) to 1.0 (any distance). Default: 0.65
RAG_MAX_DISTANCE=0.65

# Maximum total characters of retrieved chunk content sent to the LLM per request.
# Keeps prompt token usage predictable. Default: 6000 (~1500 tokens).
RAG_MAX_CONTEXT_CHARS=6000
