APP_NAME=Sentiora Backend
APP_ENVIRONMENT=development
# Log lines: text (readable) or json (one object per line). Unset: text in
# development, json elsewhere. Every line carries the request or job ID.
# LOG_FORMAT=text
# Error tracking (Sentry) for the API and worker. Off when unset. No request
# bodies, auth headers, cookies or local variables are sent.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# Prometheus metrics at http://localhost:8000/metrics (not under /api/, so
# nginx never exposes it). With several uvicorn workers also set the env var
# PROMETHEUS_MULTIPROC_DIR to an empty directory.
# METRICS_ENABLED=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/Sentiora
# If Windows already occupies 5432, publish Docker Postgres on 5433 and use 127.0.0.1:5433 here.
REDIS_URL=redis://127.0.0.1:6379/0
# Docker backend/worker ignore this and use redis://redis:6379/0.
# If host port 6379 is busy, publish Redis with REDIS_PORT=6380 and set
# REDIS_URL=redis://127.0.0.1:6380/0 for local (non-Docker) processes.
CORS_ORIGINS=["http://localhost:5173"]

# ── AI / LLM Configuration ──────────────────────────────────────────────────
# Used by the API process and the RQ worker (via this file / env_file).
# Chat provider (the primary; Groq is chat only, no embeddings):
LLM_PROVIDER=openai
# openai | gemini | openrouter | groq. Other configured providers are backups,
# tried in this order: openrouter, groq, gemini, openai.
# Embeddings for semantic search:
#   "local" | "auto" | "openrouter" | "openai" | "gemini" | "none".
# local = on this machine's CPU (fastembed); no key, nothing leaves the server,
# vectors stored in memory_chunks.embedding_local. The model downloads once into
# MODEL_CACHE_DIR on first use.
# auto = OpenRouter when an OpenRouter key is set; otherwise follow LLM_PROVIDER
# (openai/gemini), then OPENAI_API_KEY, then GEMINI_API_KEY. Without an embedding
# provider, search is full-text only. Queries only match chunks embedded with the
# same model; after changing the provider or model, run:
#   node scripts/run-python.mjs -m scripts.reprocess_memories --embed
EMBEDDING_PROVIDER=local
# Model for EMBEDDING_PROVIDER=local (S3 eval: quantized nomic-embed-text-v1.5,
# 130 MB). Only 768-dim models fit the vector(768) column; after switching to
# another one (nomic-ai/nomic-embed-text-v1.5), re-embed with
#   node scripts/run-python.mjs -m scripts.reprocess_memories --embed --force
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
# Where local model files live (relative paths are under backend/).
MODEL_CACHE_DIR=.models
# Model for the chosen provider. Empty = provider default
# (openrouter: openai/text-embedding-3-small; must return 1536 dimensions).
EMBEDDING_MODEL=
# Vector size of stored embeddings. Must stay 1536: the memory_chunks.embedding
# column is Vector(1536) in the migrations, so other values fail on insert.
# EMBEDDING_DIMENSIONS=1536

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
# Must output 1536 dimensions (text-embedding-004 cannot).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible, chat only; no embeddings). Fast first backup after
# LLM_PROVIDER, or set LLM_PROVIDER=groq to make it the primary. See
# REBUILD_PLAN D11 before using it for real users.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# OpenRouter. Keys stay server-side: never prefix them with VITE_.
# Set OPENROUTER_API_KEY and/or numbered keys OPENROUTER_API_KEY_1, _2, ... _N
# (any count, detected automatically). Ask and embeddings rotate across them.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
# Development example uses a free model; the code and docker-compose.prod.yml default
# to anthropic/claude-haiku-4.5. Models are 'vendor/model'.
OPENROUTER_CHAT_MODEL=x-ai/grok-4.1-fast:free
# Comma-separated models OpenRouter tries in order if the chat model is unavailable.
OPENROUTER_FALLBACK_MODELS=
# Key failover: a key that is out of credits, unauthorized or rate-limited is
# skipped for LLM_KEY_COOLDOWN_SECONDS, doubling on each further failure up to
# LLM_COOLDOWN_MAX_SECONDS (overloads and timeouts start at 30s). A provider's
# Retry-After is honoured. At most LLM_MAX_ATTEMPTS keys are tried per call.
LLM_KEY_COOLDOWN_SECONDS=300
LLM_COOLDOWN_MAX_SECONDS=3600
LLM_MAX_ATTEMPTS=4
# Most an answer waits for its first token, across every key it tries, so a
# provider outage fails in about this long. One-piece responses (the Gemini
# backup, POST /chat) must finish within it; raise it if they time out.
LLM_CHAT_TIMEOUT_SECONDS=10
# Unused since S6 (the answer call returns its own metadata); kept so older
# .env files still load.
LLM_META_TIMEOUT_SECONDS=8
EMBEDDING_TIMEOUT_SECONDS=10

# ── Ask v3 (S6) ──────────────────────────────────────────────────────────────
# "instant": answers quoted from the user's saves, no AI call (default).
# "ai": the written AI answer for every question (v2 behaviour, for rollback).
# A request's answer_mode overrides it ("Explain with AI" sends "ai").
ASK_DEFAULT_MODE=instant
# Reranker score a sentence needs to be quoted in an instant answer.
RAG_EXTRACT_MIN_SCORE=0.0
# AI answers running at once across all API processes; past it AI_BUSY.
LLM_MAX_CONCURRENT=10
# How long an answer is reused for the same question and library (0 = off).
ANSWER_CACHE_TTL_SECONDS=86400

# ── RAG Retrieval Tuning ─────────────────────────────────────────────────────
# Same as the code defaults in backend/app/core/config.py.
RAG_TOP_K=15
# Hybrid retrieval (pgvector + Postgres full-text, RRF, MMR)
RAG_FINAL_K=6
RAG_CANDIDATES=30
# Cross-encoder that re-orders the best fused candidates, on the CPU (S4).
# "none" turns it off. Each candidate costs ~25 ms per question.
RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
RAG_RERANK_CANDIDATES=10
# Enrichment (summary, key points, question bank) of saves that matter: Save now,
# opened in the app, or a source of an Ask answer. Requests per user per UTC day.
ENRICH_DAILY_LIMIT=50
# Version of the privacy notice users accept at sign-up (D10); must match
# PRIVACY_NOTICE_VERSION in shared/src/ui/privacyNotice.ts. A new version asks
# every user to accept again before AI features.
PRIVACY_NOTICE_VERSION=2026-11-20
# Chat model for enrichment; empty = the configured chat model (LLM_PROVIDER first).
ENRICH_MODEL=
# Cosine similarity a vector hit needs; below it (and no full-text match) the
# question counts as not covered by memory. Depends on the embedding model:
# 0.65 for local nomic-embed-text-v1.5 (S3 eval), 0.25 for remote
# openai/text-embedding-3-small.
RAG_MIN_SIMILARITY=0.65
# The same bar for the question-bank leg (stored enrichment questions, S6).
# Question-to-question scores run lower with the local model (D14 eval).
RAG_QUESTION_MIN_SIMILARITY=0.60
# A keyword-only match the reranker scores below this is dropped (S8, D16).
RAG_RERANK_MIN_SCORE=-0.6
RAG_MMR_LAMBDA=0.7
RAG_MAX_CHUNKS_PER_MEMORY=2
RAG_STRONG_DISTANCE=0.4
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_OUTPUT_TOKENS=900

JWT_SECRET_KEY=DEV_SECRET_KEY_CHANGE_IN_PRODUCTION_SENTIORA_2026
# Token settings (defaults shown; change only with a reason).
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# Non-development environments require a 32+ char JWT_SECRET_KEY and explicit CORS_ORIGINS.
# Reverse proxies whose X-Forwarded-For is trusted for client IPs (JSON list); empty = ignore the header.
TRUSTED_PROXY_IPS=[]
MAX_REQUEST_BODY_BYTES=4194304

# ── Tests ────────────────────────────────────────────────────────────────────
# pytest and Playwright never use DATABASE_URL directly. They use TEST_DATABASE_URL,
# or derive a "sentiora_test" database on the same server when it is unset, and
# refuse any database whose name lacks "test" or equals the dev database.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/sentiora_test
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_USER_PER_MINUTE=30
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_BASE_BACKOFF_SECONDS=2
FAILED_LOGIN_MAX_BACKOFF_SECONDS=60
