APP_NAME=Sentiora Backend
APP_ENVIRONMENT=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/Sentiora
# If Windows already occupies 5432, publish Docker Postgres on 5433 and use 127.0.0.1:5433 here.
REDIS_URL=redis://127.0.0.1:6379/0
# Docker backend/worker ignore this and use redis://redis:6379/0.
# If host port 6379 is busy, publish Redis with REDIS_PORT=6380 and set
# REDIS_URL=redis://127.0.0.1:6380/0 for local (non-Docker) processes.
CORS_ORIGINS=["http://localhost:5173"]

# ── AI / LLM Configuration ──────────────────────────────────────────────────
# Used by the API process and the RQ worker (via this file / env_file).
# Chat provider: "openai", "gemini", or "openrouter" (chat only, no embeddings)
LLM_PROVIDER=openai
# Embeddings for semantic search: "auto" | "openrouter" | "openai" | "gemini" | "none".
# auto = OpenRouter when an OpenRouter key is set; otherwise follow LLM_PROVIDER
# (openai/gemini), then OPENAI_API_KEY, then GEMINI_API_KEY. Without an embedding
# provider, search is full-text only. Queries only match chunks embedded with the
# same model; after changing it, run:
#   node scripts/run-python.mjs -m scripts.reprocess_memories --embed
EMBEDDING_PROVIDER=auto
# Model for the chosen provider. Empty = provider default
# (openrouter: openai/text-embedding-3-small; must return 1536 dimensions).
EMBEDDING_MODEL=
# Vector size of stored embeddings. Must stay 1536: the memory_chunks.embedding
# column is Vector(1536) in the migrations, so other values fail on insert.
# EMBEDDING_DIMENSIONS=1536

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
# Must output 1536 dimensions (text-embedding-004 cannot).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
# Development example uses a free model; the code and docker-compose.prod.yml default
# to anthropic/claude-haiku-4.5.
OPENROUTER_CHAT_MODEL=x-ai/grok-4.1-fast:free
# Comma-separated models OpenRouter tries in order if the chat model is unavailable.
OPENROUTER_FALLBACK_MODELS=
# Optional second OpenRouter key. Ask rotates across every chat key that is set
# (this one, OPENROUTER_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY) and skips a key
# that is out of credits or rate-limited for LLM_KEY_COOLDOWN_SECONDS.
OPENROUTER_API_KEY_2=
LLM_KEY_COOLDOWN_SECONDS=300

# Ask Sentiora without a key still returns a grounded local answer from
# retrieved READY memory. Semantic search falls back to lexical matching.
# Set a provider key for LLM-generated answers.

# ── RAG Retrieval Tuning ─────────────────────────────────────────────────────
# Same as the code defaults in backend/app/core/config.py.
RAG_TOP_K=15
# Hybrid retrieval (pgvector + Postgres full-text, RRF, MMR)
RAG_FINAL_K=6
RAG_CANDIDATES=30
# Cosine similarity a vector hit needs; below it (and no full-text match) the
# question counts as not covered by memory.
RAG_MIN_SIMILARITY=0.25
RAG_MMR_LAMBDA=0.7
RAG_MAX_CHUNKS_PER_MEMORY=2
RAG_STRONG_DISTANCE=0.4
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_OUTPUT_TOKENS=900

JWT_SECRET_KEY=DEV_SECRET_KEY_CHANGE_IN_PRODUCTION_SENTIORA_2026
# Token settings (defaults shown; change only with a reason).
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# Non-development environments require a 32+ char JWT_SECRET_KEY and explicit CORS_ORIGINS.
# Reverse proxies whose X-Forwarded-For is trusted for client IPs (JSON list); empty = ignore the header.
TRUSTED_PROXY_IPS=[]
MAX_REQUEST_BODY_BYTES=4194304

# ── Tests ────────────────────────────────────────────────────────────────────
# pytest and Playwright never use DATABASE_URL directly. They use TEST_DATABASE_URL,
# or derive a "sentiora_test" database on the same server when it is unset, and
# refuse any database whose name lacks "test" or equals the dev database.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_LOCAL_DEV@127.0.0.1:5432/sentiora_test
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_USER_PER_MINUTE=30
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_BASE_BACKOFF_SECONDS=2
FAILED_LOGIN_MAX_BACKOFF_SECONDS=60
